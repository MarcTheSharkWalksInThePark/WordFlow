index.html text eol=crlf
app.js text eol=crlf
styles.css text eol=crlf
assets/wordflow-mark.svg text eol=crlf
server.js text eol=crlf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.sh text eol=lf
.githooks/* text eol=lf
tools/push.log text eol=lf
_headers text eol=lf
api/read text eol=lf
404.html text eol=lf
LICENSE text eol=lf
functions/api/read.js text eol=lf
*.pdf -text
